# Required. The granite database holding `chat_messages`. Also used by
# `cargo test`, which creates a throw-away database per test on this server.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/main?ssl-mode=DISABLED
DB_MAX_CONNECTIONS=5

# Per-job directories are created here and deleted afterwards. Default: ./workspaces
WORKSPACE_ROOT=./workspaces
POLL_INTERVAL_SECS=5
# How many jobs run at the same time. Each one is a `claude` process
# (roughly 150-250 MB, more on long jobs), so size the machine accordingly. Default: 1
MAX_CONCURRENT_JOBS=5
HTTP_ADDR=127.0.0.1:8080
# Reset orphaned 'pending' rows on start-up. Set to false if you run more than one worker.
REQUEUE_PENDING_ON_START=true

# --- claude subprocess -------------------------------------------------------
CLAUDE_BIN=claude
# CLAUDE_MODEL=opus
CLAUDE_MAX_TURNS=50
# CLAUDE_MAX_BUDGET_USD=2.00
CLAUDE_TIMEOUT_SECS=1800
# acceptEdits (recommended) or bypassPermissions (Edit/Write tools may then leave the workspace)
CLAUDE_PERMISSION_MODE=acceptEdits
# Domains sandboxed shell commands may reach, comma separated. Empty = none.
# CLAUDE_ALLOWED_DOMAINS=github.com,*.npmjs.org
# Keep transcripts under the Claude config dir after the job. Default: false
CLAUDE_PERSIST_SESSIONS=false
# Use a dedicated Claude config dir (settings, CLAUDE.md, MCP servers) for jobs.
# CLAUDE_CONFIG_DIR=/Users/you/.claude-job-runner
# MCP servers for jobs, as a JSON file ({"mcpServers": {...}}). Servers from the
# config dir are never inherited; unset = no MCP servers at all (each one is an
# extra Node process, so leave this unset unless jobs need them).
# CLAUDE_MCP_CONFIG=/Users/you/.claude-job-runner/mcp.json

RUST_LOG=info
